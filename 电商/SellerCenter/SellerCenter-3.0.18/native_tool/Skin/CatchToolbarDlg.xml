<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Window size="388,38" showshadow="true" shadowimage="shadow.png" shadowcorner="23,13,23,33">  <!-- 280 = 9(按钮数量)*30(按钮宽度) + 5(边距)*2-->
<Font id="1" name="微软雅黑" size="15" bold="false" default="true" />
<VerticalLayout width="388"  height="38">	
	<HorizontalLayout name="capture" width="388"  height="38" inset="7,7,7,7" bkcolor="#FF383838">
		<Option name="Btn_Rectangle" width="24" height="24" padding="9,0,0,0" tooltip="方框" normalimage="res='icon_rec_normal.png'" selectedimage="res='icon_rec_click.png'" group="ToolGroup" />
		<Option name="Btn_Arrow" width="24" height="24" padding="8,0,0,0" tooltip="箭头" normalimage="res='icon_arrow_normal.png'" selectedimage="res='icon_arrow_click.png'" group="ToolGroup" />
		<Option name="Btn_Ellipse" width="24" height="24" padding="8,0,0,0" tooltip="椭圆" normalimage="res='icon_circle_normal.png'" selectedimage="res='icon_circle_click.png'" group="ToolGroup" />	
		<Option name="Btn_Mosaic" width="24" height="24" padding="8,0,0,0" tooltip="马赛克" visible="true" normalimage="res='icon_mosaic_normal.png'" selectedimage="res='icon_mosaic_click.png'" group="ToolGroup" />
		<Option name="Btn_Text" width="24" height="24" padding="8,0,0,0" tooltip="文本" visible="true" normalimage="res='icon_text_normal.png'" selectedimage="res='icon_text_click.png'" group="ToolGroup" />
		<Option name="Btn_Curve" width="24" height="24" padding="8,0,0,0" tooltip="曲线" normalimage="res='icon_curve.png'" selectedimage="res='icon_curve_click.png'" group="ToolGroup" />
		<Button name="Btn_OCR" width="24" height="24" padding="8,0,0,0" tooltip="提取文字" normalimage="res='ocr.png'" pushedimage="res='ocr.png'" group="ToolGroup" />
		<Control width="10"/>
		<Control width="1" height="20" padding="0,2,0,2" bkcolor="#FF999999" />
		<Control width="10"/>
		<Button name="Btn_Undo" width="24" height="24" padding="0,0,0,0" tooltip="撤销" disabledimage="res='icon_undo_disable.png'" normalimage="res='icon_undo_normal.png'" pushedimage="res='icon_undo_active.png'" />
		<Button name="Btn_Save" width="24" height="24" padding="8,0,0,0" normalimage="res='icon_save_normal.png'" pushedimage="res='icon_save_active.png'" tooltip="保存"   />
		<Button name="Btn_Quit" width="24" height="24" padding="8,0,0,0" tooltip="退出" bkimage="res='icon_cancel.png'  "/>
		<Button name="Btn_Complete" width="24" height="24" padding="8,0,0,0" tooltip="完成" bkimage="res='icon_confirm.png'  "/>
	</HorizontalLayout>

	<HorizontalLayout name="record" width="231"  height="42"  bkcolor="#FF383838 ">
		<Label name="time" text="00:00 / 05:00" height="20" width="95" textcolor="#FFF2F2F2" padding="16,11,0,0" font="1"/>
		<Button name="Btn_Record" width="88" height="28" padding="20,7,0,0"  normalimage="res='start_record.png'" pushedimage="res='pushed_start_record.png'"/>
		<Button name="Btn_FinishRecord" width="88" height="28" padding="20,7,0,0" normalimage="res='finish_record.png'" pushedimage="res='pushed_finish_record.png'" visible="false"/>
	</HorizontalLayout>
